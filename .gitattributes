# Use Unix line endings for text in every checkout.
* text=auto eol=lf
# Windows command scripts require CRLF when present.
*.bat text eol=crlf
*.cmd text eol=crlf
*.c text eol=lf
*.h text eol=lf
*.inc text eol=lf
*.mk text eol=lf
Makefile text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.rst text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.hex text eol=lf
*.png binary
*.ico binary
*.uze binary
